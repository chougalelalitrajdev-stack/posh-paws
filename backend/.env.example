# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
APP_NAME="Posh Paws API"
# The database. On the Mac: the local posh_paws database (no password). Online: the host's address with its password.
DATABASE_URL="postgresql+psycopg://localhost:5432/posh_paws"
# Signs sign-in tokens. Online: a long random value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"), never committed.
SECRET_KEY="dev-only-not-secret-use-a-long-random-key-online"
# true = print every database query in the server's terminal (handy while learning; keep false online)
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:4200","http://localhost:4300"]
